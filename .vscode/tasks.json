{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "detail": "Build the ASP.NET Core API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backEnd/personalSite/personalSite.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: run",
      "detail": "Run the ASP.NET Core API (http profile on http://localhost:5009)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/backEnd/personalSite/personalSite.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Now listening on:"
        }
      },
      "presentation": {
        "group": "dev",
        "panel": "dedicated"
      }
    },
    {
      "label": "frontend: dev",
      "detail": "Run the Vite dev server (http://localhost:5173)",
      "type": "shell",
      "command": "nvm use 22.22.2; npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontEnd"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "group": "dev",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev: full stack",
      "detail": "Run backend API and frontend dev server together",
      "dependsOn": ["backend: run", "frontend: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
